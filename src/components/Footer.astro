---
import { profile } from "../data/profile";
const sha = (import.meta.env.PUBLIC_COMMIT_SHA ?? "local").slice(0, 7);
const built = new Date().toISOString().slice(0, 10);
const repo = "https://github.com/AbdulHadi1010/AbdulHadi1010.github.io";
---

<div class="band-navy">
<footer class="mx-auto max-w-[1320px] px-4 pb-10 pt-6 sm:px-8">
  <p aria-hidden="true" class="overflow-hidden whitespace-nowrap font-mono text-[11px] text-line select-none">{"─┼".repeat(120)}</p>
  <div class="mt-6 flex flex-col justify-between gap-4 sm:flex-row">
    <p class="label">© {new Date().getFullYear()} {profile.name}. Built with Astro, shipped by GitHub Actions.</p>
    <p class="label">
      <a href={repo} target="_blank" rel="noopener" class="hover:!text-text" data-scramble>source</a>
      · build <span class="text-accent">{sha}</span> · {built}
    </p>
  </div>
</footer>
</div>
