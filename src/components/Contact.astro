---
import { profile, projects, writing, stack } from "../data/profile";
import SectionHead from "./SectionHead.astro";

// Data the terminal can print. Kept server-side so the page ships plain JSON.
const data = {
  email: profile.email,
  links: profile.links,
  projects: projects.map((p) => ({ title: p.title, href: p.href, outcome: p.outcome })),
  writing: writing.slice(0, 4).map((w) => ({ title: w.title, href: w.href })),
  stack: stack.map((s) => `${s.group.padEnd(14)} ${s.items.join(", ")}`),
};
---

<section id="contact" class="mx-auto max-w-[1320px] scroll-mt-20 px-4 py-24 sm:px-8 md:py-32" aria-labelledby="contact-title">
  <SectionHead id="contact-title" index="05" label="Contact" title="Have a cluster that <em>needs work?</em>" />

  <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
    <div data-reveal class="md:col-span-5">
      <p class="max-w-[40ch] text-lg text-muted">
        Platform builds, cloud migrations, Kubernetes hardening, or getting a model to serve fast on hardware you already pay for. Email is quickest.
      </p>
      <a href={`mailto:${profile.email}`} class="link-u mt-8 inline-block font-serif text-[clamp(1.5rem,3vw,2.3rem)] leading-tight break-all">{profile.email}</a>
      <ul class="mt-10 grid grid-cols-2 gap-px border border-line bg-line">
        {Object.entries(profile.links).map(([k, v]) => (
          <li class="bg-bg">
            <a href={v} target="_blank" rel="noopener me" class="flex items-center justify-between px-4 py-3 font-mono text-[13px] capitalize transition-colors hover:bg-surface">
              <span data-scramble>{k}</span><span class="text-muted" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal style="--d:120ms" class="md:col-span-7">
      <div class="border border-line bg-surface/70 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.5)]">
        <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
          <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
          <span class="h-2.5 w-2.5 rounded-full border border-line"></span>
          <span class="label ml-3">guest@abdulhadi: ~</span>
        </div>
        <div data-term-out class="h-[340px] overflow-y-auto px-4 py-4 font-mono text-[13px] leading-[1.7]" role="log" aria-live="polite" aria-label="Terminal output" data-lenis-prevent></div>
        <form data-term-form class="flex items-center gap-2 border-t border-line px-4 py-3 font-mono text-[13px]">
          <label for="term-in" class="text-accent">❯</label>
          <input id="term-in" data-term-in autocomplete="off" spellcheck="false" class="w-full bg-transparent outline-none placeholder:text-muted/70" placeholder="type help, or click a command" />
        </form>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {["whoami", "projects", "stack", "writing", "contact"].map((c) => (
          <button type="button" data-term-cmd={c} class="border border-line px-2.5 py-1 font-mono text-[12px] text-muted transition-colors hover:border-accent hover:text-text">{c}</button>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="term-data" set:html={JSON.stringify(data)} />

<script>
  type Data = {
    email: string;
    links: Record<string, string>;
    projects: { title: string; href: string; outcome: string }[];
    writing: { title: string; href: string }[];
    stack: string[];
  };
  const data = JSON.parse(document.getElementById("term-data")!.textContent!) as Data;
  const out = document.querySelector<HTMLElement>("[data-term-out]")!;
  const form = document.querySelector<HTMLFormElement>("[data-term-form]")!;
  const input = document.querySelector<HTMLInputElement>("[data-term-in]")!;
  const history: string[] = [];
  let hi = 0;

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const link = (href: string, text = href) => `<a href="${esc(href)}" target="_blank" rel="noopener" class="underline decoration-line underline-offset-4 hover:decoration-current">${esc(text)}</a>`;
  const print = (html: string, cls = "") => {
    const div = document.createElement("div");
    div.className = `whitespace-pre-wrap ${cls}`;
    div.innerHTML = html;
    out.appendChild(div);
    out.scrollTop = out.scrollHeight;
  };

  const commands: Record<string, () => string> = {
    help: () =>
      ["available commands:", "  whoami     who is this", "  projects   selected work", "  stack      tools I use", "  writing    recent posts", "  contact    how to reach me", "  clear      clear the screen"].join("\n"),
    whoami: () =>
      "Abdul Hadi. Solutions Architect at SazebTech Consulting.\nKubernetes, AWS, Azure, private clouds, AI inference.\nCKA · AWS Solutions Architect · Azure Fundamentals.",
    projects: () => data.projects.map((p, i) => `${String(i + 1).padStart(2, "0")}  ${link(p.href, p.title)}\n    ${esc(p.outcome)}`).join("\n"),
    stack: () => data.stack.map(esc).join("\n"),
    writing: () => data.writing.map((w) => `·  ${link(w.href, w.title)}`).join("\n"),
    contact: () =>
      [`email     ${link("mailto:" + data.email, data.email)}`, ...Object.entries(data.links).map(([k, v]) => `${k.padEnd(9)} ${link(v)}`)].join("\n"),
    ls: () => "about.txt  projects/  writing/  contact.txt",
    "cat about.txt": () => commands.whoami(),
    "sudo rm -rf /": () => "nice try. this filesystem is read-only and deployed from git.",
    "kubectl get pods": () => "NAME                         READY   STATUS    AGE\nportfolio-7c9d5b8f6d-x2k9q   1/1     Running   since the last commit",
  };

  const run = (raw: string) => {
    const cmd = raw.trim().replace(/\s+/g, " ");
    print(`<span class="text-accent">❯</span> ${esc(cmd)}`, "text-muted");
    if (!cmd) return;
    history.push(cmd);
    hi = history.length;
    if (cmd === "clear") { out.innerHTML = ""; return; }
    const fn = commands[cmd.toLowerCase()];
    print(fn ? fn() : `command not found: ${esc(cmd)}. try <span class="text-accent">help</span>`, "mb-3");
  };

  print(`Last login: ${new Date().toUTCString()} on ttys001`, "text-muted");
  print(`Type <span class="text-accent">help</span> to list commands.`, "mb-3");

  form.addEventListener("submit", (e) => { e.preventDefault(); run(input.value); input.value = ""; });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowUp" && hi > 0) { hi--; input.value = history[hi]; e.preventDefault(); }
    if (e.key === "ArrowDown") { hi = Math.min(history.length, hi + 1); input.value = history[hi] ?? ""; e.preventDefault(); }
  });
  document.querySelectorAll<HTMLButtonElement>("[data-term-cmd]").forEach((b) =>
    b.addEventListener("click", () => run(b.dataset.termCmd!)),
  );
</script>
