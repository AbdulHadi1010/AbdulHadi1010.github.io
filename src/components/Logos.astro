---
import { logoGroups } from "../data/logos";
import Logo from "./Logo.astro";
import SectionHead from "./SectionHead.astro";
---

<div class="band-tint">
<section id="stack" class="mx-auto max-w-[1320px] scroll-mt-20 px-4 py-24 sm:px-8 md:py-32" aria-labelledby="stack-title">
  <SectionHead id="stack-title" index="02" label="Toolchain" title="What I build with, <em>day to day.</em>" />
  <div data-reveal class="grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {logoGroups.map((g) => (
      <div class="bg-bg p-5">
        <h3 class="label mb-5">{g.group}</h3>
        <ul class="grid grid-cols-2 gap-x-3 gap-y-4 lg:grid-cols-1 xl:grid-cols-2">
          {g.items.map(([key, name]) => (
            <li class="group flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[11px] bg-[#f6f5f2] p-2 text-[#1b1b1b] shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06),0_6px_16px_-10px_rgba(0,0,0,0.5)] transition-transform duration-300 group-hover:-translate-y-1 group-hover:rotate-[-3deg]">
                <Logo k={key} size={28} />
              </span>
              <span class="text-[14px] leading-tight">{name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="flex flex-col justify-between bg-surface p-5">
      <h3 class="label">Certified</h3>
      <ul class="mt-5 space-y-2 text-[15px]">
        <li><span class="text-accent">●</span> Certified Kubernetes Administrator</li>
        <li><span class="text-accent">●</span> AWS Solutions Architect</li>
        <li><span class="text-accent">●</span> Azure Fundamentals</li>
      </ul>
    </div>
  </div>
</section>
</div>
