---
import { profile } from "../data/profile";
const [first] = profile.rotating;
---

<section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden pt-14" aria-labelledby="hero-title">
  <div class="hairline-grid pointer-events-none absolute inset-0 -z-20 opacity-60"></div>
  <canvas data-ascii-globe class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(90deg,var(--bg)_0%,color-mix(in_oklab,var(--bg)_82%,transparent)_34%,transparent_62%)] max-md:bg-[linear-gradient(180deg,var(--bg)_0%,color-mix(in_oklab,var(--bg)_75%,transparent)_45%,transparent_70%)]"></div>

  <div class="mx-auto flex w-full max-w-[1320px] flex-1 flex-col justify-center px-4 py-16 sm:px-8">
    <p class="rise label mb-8 flex items-center gap-2.5" style="--d:100ms">
      <span class="live-dot"></span>
      Open to infra roles and contracts
    </p>

    <h1 id="hero-title" class="rise max-w-[14ch] font-serif text-[clamp(2.6rem,7vw,6.2rem)] leading-[1.02]" style="--d:200ms">
      Engineering infrastructure for
      <span class="block text-accent"><span data-rotate={JSON.stringify(profile.rotating)}>{first}</span><span class="caret font-light">|</span></span>
    </h1>

    <p class="rise tagline mt-7 max-w-[44ch] text-[1.1rem] sm:text-[1.3rem]" style="--d:350ms">
      I build <b>cloud platforms</b> that don't just run, they <b>perform</b>. Kubernetes, AWS, Azure, private clouds and the pipelines that ship to them.
    </p>

    <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--d:480ms">
      <a href="#work" class="btn-brand text-[1.05rem]">
        Explore my work <span aria-hidden="true">→</span>
      </a>
      <button type="button" data-copy={profile.email} class="btn-ghost text-[14px] font-medium">
        <span data-copy-label>{profile.email}</span>
        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" class="text-muted"><rect x="4.5" y="4.5" width="9" height="9" fill="none" stroke="currentColor" /><path d="M2.5 11V2.5H11" fill="none" stroke="currentColor" /></svg>
      </button>
    </div>
  </div>

  <div class="mx-auto grid w-full max-w-[1320px] grid-cols-2 gap-y-2 border-t border-line/70 bg-bg/70 px-4 py-4 backdrop-blur-sm sm:grid-cols-4 sm:bg-transparent sm:backdrop-blur-none sm:px-8">
    <span class="label">{profile.title}</span>
    <span class="label sm:text-center">CKA · AWS SA · Azure</span>
    <span class="label sm:text-center">{profile.location} · UTC+5</span>
    <span class="label text-right">Scroll ↓</span>
  </div>
</section>
