---
import { marquee } from "../data/logos";
import Logo from "./Logo.astro";
---

<!-- Scrolling strip right under the hero -->
<div class="relative overflow-hidden border-y border-line py-6" aria-label="Platforms I work with">
  <div class="marquee flex w-max items-center" data-marquee>
    {[0, 1].map((dup) => (
      <ul class="flex items-center gap-14 pr-14" aria-hidden={dup === 1 ? "true" : undefined}>
        {marquee.map(([key, name]) => (
          <li class="flex h-9 items-center gap-3 text-text/80" title={name}>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-[9px] bg-white p-1.5 shadow-[0_0_0_1px_rgba(0,64,90,0.08)]"><Logo k={key} size={24} /></span>
            <span class="whitespace-nowrap font-mono text-[12px] tracking-wide text-muted">{name}</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-bg to-transparent"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-bg to-transparent"></div>
</div>

<style>
  .marquee { animation: scroll-x 60s linear infinite; }
  .marquee:hover { animation-play-state: paused; }
  @keyframes scroll-x { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { animation: none; } }
</style>
