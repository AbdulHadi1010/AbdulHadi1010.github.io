---
import { projects, stats, moreProjects } from "../data/profile";
import Logo from "./Logo.astro";
import SectionHead from "./SectionHead.astro";
import ProjectVisual from "./ProjectVisual.astro";
---

<section class="mx-auto max-w-[1320px] px-4 py-24 sm:px-8 md:py-32" aria-labelledby="stats-title">
  <h2 id="stats-title" class="sr-only">In numbers</h2>
  <dl class="grid grid-cols-2 border-l border-t border-line md:grid-cols-4">
    {stats.map((s, i) => (
      <div data-reveal style={`--d:${i * 90}ms`} class="flex flex-col border-b border-r border-line p-5 sm:p-7">
        <dt class="label order-2 mt-3 block max-w-[22ch] normal-case tracking-normal">{s.label}</dt>
        <dd class="font-serif text-[clamp(2.4rem,5vw,4rem)] leading-none">{s.value}</dd>
      </div>
    ))}
  </dl>
</section>

<section id="work" class="mx-auto max-w-[1320px] scroll-mt-20 px-4 pb-24 sm:px-8 md:pb-32" aria-labelledby="work-title">
  <SectionHead id="work-title" index="01" label="Selected work" title="Things I built, measured, <em>and wrote down.</em>" />

  <ol class="space-y-6 md:space-y-8">
    {projects.map((p, i) => (
      <li data-reveal class="group grid grid-cols-1 items-center gap-8 rounded-[28px] border border-line bg-surface/50 p-5 sm:p-8 md:grid-cols-12 md:gap-12 md:p-10">
        <div class={`md:col-span-6 ${i % 2 ? "md:order-2" : ""}`}>
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span class="flex -space-x-2" aria-hidden="true">
              {p.logos.map((k) => (
                <span class="grid h-10 w-10 place-items-center rounded-[11px] bg-white p-2 shadow-[0_0_0_2px_var(--surface),0_6px_14px_-8px_rgba(0,64,90,0.45)] transition-transform duration-300 group-hover:-translate-y-0.5 [&:nth-child(2)]:group-hover:translate-x-1 [&:nth-child(3)]:group-hover:translate-x-2"><Logo k={k} size={24} /></span>
              ))}
            </span>
            <span class="rounded-full bg-accent/15 px-3 py-1 text-[12px] font-semibold text-text">{p.kind}</span>
            <span class="text-[12px] font-medium text-muted">{p.year}</span>
          </div>
          <h3 class="font-serif text-[clamp(1.8rem,3.2vw,2.6rem)] leading-[1.08]">
            <a href={p.href} target="_blank" rel="noopener" class="link-u">{p.title}</a>
          </h3>
          <p class="mt-4 max-w-[56ch] text-[15.5px] leading-relaxed text-muted">{p.summary}</p>
          <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent/15 px-4 py-1.5 text-[14px] font-semibold text-text">
            <span class="text-accent" aria-hidden="true">●</span>{p.outcome}
          </p>
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tools">
            {p.stack.map((t) => <li class="rounded-full border border-line bg-bg px-3 py-1 text-[12px] font-medium text-muted">{t}</li>)}
          </ul>
          <a href={p.href} target="_blank" rel="noopener" class="mt-7 inline-flex items-center gap-2 text-[14px] font-bold italic text-text transition-[gap] hover:gap-3">
            {p.href.includes("github.com") ? "View the source" : "Read the write-up"} <span class="text-accent" aria-hidden="true">→</span>
          </a>
        </div>
        <figure class={`md:col-span-6 ${i % 2 ? "md:order-1" : ""}`} aria-label={`Live diagram: ${p.title}`}>
          <ProjectVisual slug={p.slug} />
        </figure>
      </li>
    ))}
  </ol>

  <div class="mt-24">
    <div data-reveal class="mb-8 flex items-end justify-between gap-6">
      <h3 class="font-serif text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">More from the field</h3>
      <a href="https://blog.stryxon.com/projects" target="_blank" rel="noopener" class="label shrink-0 hover:!text-text" data-scramble>Full list ↗</a>
    </div>
    {moreProjects.map((g) => (
      <div class="mb-12">
        <p data-reveal class="label mb-4">{g.group}</p>
        <ul data-reveal class="grid grid-cols-1 gap-px border border-line bg-line md:grid-cols-2 xl:grid-cols-3">
          {g.items.map((it) => (
            <li class="group flex flex-col bg-bg p-6 transition-colors hover:bg-surface">
              <div class="mb-5 flex items-center gap-2">
                {it.logos.map((k) => <span class="grid h-8 w-8 place-items-center rounded-[8px] bg-white p-1.5 shadow-[0_0_0_1px_rgba(0,64,90,0.08)]"><Logo k={k} size={20} /></span>)}
              </div>
              <h4 class="text-[17px] font-medium leading-snug">{it.title}</h4>
              <p class="mt-2 flex-1 text-[14.5px] leading-relaxed text-muted">{it.detail}</p>
              <p class="mt-4 font-mono text-[11px] text-muted/80">{it.tags.join(" · ")}</p>
            </li>
          ))}
          {Array.from({ length: (2 - (g.items.length % 2)) % 2 }).map(() => <li aria-hidden="true" class="hidden bg-bg md:block xl:hidden" />)}
          {Array.from({ length: (3 - (g.items.length % 3)) % 3 }).map(() => <li aria-hidden="true" class="hidden bg-bg xl:block" />)}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  import "../scripts/work-visuals.ts";
</script>
