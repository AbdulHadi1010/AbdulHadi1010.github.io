---
import { profile } from "../data/profile";
import SectionHead from "./SectionHead.astro";

const facts: [string, string][] = [
  ["Name", "Abdul Hadi"],
  ["Role", "Solutions Architect, SazebTech Consulting"],
  ["Focus", "Kubernetes and OpenShift platforms, AWS and Azure, private cloud, DevSecOps, LLM inference"],
  ["Certifications", "Certified Kubernetes Administrator (CKA), AWS Certified Solutions Architect, Azure Fundamentals"],
  ["Education", "BS Computer Science, University of Central Punjab"],
  ["Based in", "Pakistan (UTC+5), working with teams worldwide"],
];
---

<section id="about" class="mx-auto max-w-[1320px] scroll-mt-20 px-4 py-24 sm:px-8 md:py-32" aria-labelledby="about-title">
  <SectionHead id="about-title" index="03" label="About" title="Abdul Hadi, <em>in short.</em>" />
  <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
    <div data-reveal class="space-y-5 text-[1.05rem] leading-relaxed md:col-span-7">
      <p>
        <strong>Abdul Hadi</strong> is a cloud, DevOps and AI infrastructure engineer based in Pakistan. He works as a
        Solutions Architect at SazebTech Consulting, where he builds Kubernetes and OpenShift platforms, runs cloud
        migrations on AWS and Azure, and stands up private cloud infrastructure: IBM Storage Ceph, highly available
        PostgreSQL with Patroni, Cloudera clusters and enterprise key management.
      </p>
      <p class="text-muted">
        He is a Certified Kubernetes Administrator (CKA) and an AWS Certified Solutions Architect. His research,
        <a class="link-u text-text" href="https://github.com/AbdulHadi1010/secure-but-broken" target="_blank" rel="noopener"><em class="not-italic font-medium">Secure but Broken?</em></a>,
        tests whether LLM-written fixes for Kubernetes security misconfigurations still work once deployed. He writes
        hands-on runbooks on <a class="link-u text-text" href={profile.links.medium} target="_blank" rel="noopener me">Medium</a>
        and runs AWS and AI workshops for computer science students.
      </p>
    </div>
    <dl data-reveal class="divide-y divide-line rounded-2xl border border-line bg-surface/60 md:col-span-5">
      {facts.map(([k, v]) => (
        <div class="grid grid-cols-[7.5rem_1fr] gap-4 px-5 py-3.5">
          <dt class="label pt-0.5">{k}</dt>
          <dd class="text-[14.5px] leading-snug">{v}</dd>
        </div>
      ))}
      <div class="grid grid-cols-[7.5rem_1fr] gap-4 px-5 py-3.5">
        <dt class="label pt-0.5">Profiles</dt>
        <dd class="flex flex-wrap gap-x-4 gap-y-1 text-[14.5px]">
          <a class="link-u font-medium" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
          <a class="link-u font-medium" href={profile.links.github} target="_blank" rel="noopener me">GitHub</a>
          <a class="link-u font-medium" href={profile.links.medium} target="_blank" rel="noopener me">Medium</a>
          <a class="link-u font-medium" href={profile.links.youtube} target="_blank" rel="noopener me">YouTube</a>
        </dd>
      </div>
    </dl>
  </div>
</section>
